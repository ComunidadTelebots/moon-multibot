# ====================================
# Moon Multibot - Configuracion
# ====================================

# --- Flask & Web ---
WEB_PASSWORD=tu_contrasena_segura
JWT_SECRET=tu_jwt_secret_muy_seguro
MOON_ENV=prod
MOON_ROLE=master
MASTER_ID=123456789

# --- Cifrado de tokens ---
# Generado automaticamente en primera ejecucion si se deja vacio.
# Copia aqui el valor impreso en consola para conservar acceso a bots cifrados.
CIPHER_KEY=

# --- IA & LLM ---
GEMINI_API_KEY=tu_gemini_api_key
USE_EXTERNAL_LLM=false
HYBRID_PERCENTAGE=50
LLM_PROVIDER=gemini
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2:0.5b

# --- Deep Dream Mode ---
DEEP_DREAM_MODE=false

# --- VirusTotal (opcional) ---
VT_API_KEY=

