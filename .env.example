# ====================================
# 🌙 Moon Multibot - Configuración
# ====================================

# --- Flask & Web ---
WEB_PASSWORD=tu_contraseña_segura
JWT_SECRET=tu_jwt_secret_muy_seguro
MOON_ENV=prod  # prod o dev
MOON_ROLE=master  # master o slave
MASTER_ID=123456789  # Tu ID de Telegram

# --- Cifrado de Tokens (Generado automáticamente en primera ejecución)
# Copia el valor generado en consola aquí
CIPHER_KEY=

# --- IA & LLM ---
GEMINI_API_KEY=tu_gemini_api_key
USE_EXTERNAL_LLM=false
HYBRID_PERCENTAGE=50
LLM_PROVIDER=gemini  # gemini o ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2:0.5b

# --- Deep Dream Mode ---
DEEP_DREAM_MODE=false

# --- Proxies & MTProto (Opcional) ---
# PROXY_PORT=443
# PROXY_SECRET=tu_secret_de_proxy
